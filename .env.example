# MyMedha LXP backend — environment template. Copy to .env and fill real values.
# .env is gitignored; never commit real secrets.

# dev | staging | prod   (staging/prod enforce required secrets + X-Tenant-ID)
ENV=dev

# Mongo
MONGODB_URI=
MONGODB_DB=aibuddy-dev

# Security  (CHANGE BOTH FOR PROD — startup refuses the dev placeholders in prod)
API_KEY_VALUE=dev-local-key
JWT_SECRET=changeme

# Azure OpenAI (fallback chat + embeddings)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Google Gemini (primary summary/story/quiz generation)
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_STORY_MODEL=gemini-2.5-flash

# Anthropic (simulation HTML/SVG only)
ANTHROPIC_API_KEY=

# Azure Speech (STT/TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_TTS_KEY=
AZURE_SPEECH_TTS_REGION=centralindia

# Azure Storage (audio + NCERT figures blob + queues)
AZURE_STORAGE_CONNECTION_STRING=
AUDIO_CONTAINER_NAME=schools
AUDIO_QUEUE_NAME=transcription-queue
SUMMARY_QUEUE_NAME=summary-ready
SUMMARY_POISON_QUEUE_NAME=summary-poison
NCERT_BLOB_CONTAINER=ncert
